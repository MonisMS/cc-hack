# Copy to backend/.env and fill in. Never commit .env.

# Neon: use the DIRECT connection string (not "-pooler"), with the +psycopg driver prefix:
# postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=

# Cloudinary Dashboard -> API Keys -> "API environment variable"
# cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=

GEMINI_API_KEY=
CEREBRAS_API_KEY=
GROQ_API_KEY=
# openrouter.ai -> Keys. Used first when set (free models, see app/core/config.py).
OPENROUTER_API_KEY=

# Set to 1 after the CLIP models are downloaded so startup never waits on the internet.
HF_HUB_OFFLINE=0
